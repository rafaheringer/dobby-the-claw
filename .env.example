# Example environment file for Dobby bridge.
# Keep credentials empty here and set real values in your local .env file.

# Core bridge settings
BRIDGE_MODE=realtime
BRIDGE_LOG_LEVEL=INFO
REACHY_BRIDGE_URL=sdk
IDLE_SLEEP_TIMEOUT_S=300

# Realtime speech and audio
REALTIME_MODEL=gpt-realtime
REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
REALTIME_VAD_SILENCE_MS=200
REALTIME_VAD_PREFIX_PADDING_MS=150
STT_LANGUAGE=pt
# Native Reachy speaker volume (0-100).
# Use 100 on Raspberry Pi to force max output on bridge startup.
# Use -1 to keep the current system volume unchanged.
REACHY_OUTPUT_VOLUME=-1
# On Linux, use direct ALSA capture/playback for bridge audio instead of SDK GStreamer audio.
REACHY_DIRECT_ALSA_AUDIO=1
# ALSA device for direct capture/playback. Default "default" works in Docker (entrypoint writes
# .asoundrc). For native Raspberry Pi runs, point at the Reachy USB card, e.g. plughw:CARD=Audio.
REACHY_ALSA_DEVICE=default

# Vision and motion tracking
# Maximum width used for CPU-bound head and finger tracking.
# Lower values reduce Raspberry Pi load.
VISION_TRACKING_MAX_WIDTH=640
# Maximum tracking rate for CPU-bound head and finger tracking.
# Lower values reduce Raspberry Pi load.
VISION_TRACKING_FPS=15.0
HEAD_TRACKING_ENABLED=1
ANTENNA_FINGER_TRACKING_ENABLED=1
ANTENNA_FINGER_MAX_ANGLE_DEG=180.0
CAMERA_TOOL_ENABLED=1

# Offline wake word
OFFLINE_WAKEWORD_ENABLED=1
# While asleep, each burst of speech is transcribed locally (faster-whisper) and the robot wakes
# when the text says one of these names.
OFFLINE_WAKEWORD_ALIASES=reachy,dobby
# Whisper model size: base (~1.2 s per burst on a PC CPU) or small (more accurate, ~3x slower).
# Downloaded once into the Hugging Face cache.
OFFLINE_WAKEWORD_MODEL=base

# Raspberry Pi
# SSH connection used by the debug window's Pi stats. Host may be a hostname or IP.
PI_SSH_HOST=raspberrypi.local
PI_SSH_USER=dobby

# Web UI (PWA with status, chat, camera and logs). Listens on localhost only; reach it from the
# phone through the Cloudflare tunnel. Remote requests are refused unless Cloudflare Access is
# configured: set the team domain and the application's AUD tag (Zero Trust > Access > Applications).
WEB_UI_ENABLED=1
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=18900
WEB_UI_ACCESS_TEAM_DOMAIN=
WEB_UI_ACCESS_AUDIENCE=
# Optional extra allow-list on top of the Access policy (comma-separated e-mails).
WEB_UI_ALLOWED_EMAILS=
# Sites allowed to embed the page in an iframe, comma-separated (e.g. https://ha.example.com for an HA panel).
WEB_UI_FRAME_ANCESTORS=

# OpenClaw delegation
OPENCLAW_ENABLED=1
OPENCLAW_WS_URL=ws://127.0.0.1:18789
OPENCLAW_BEARER_TOKEN=
OPENCLAW_TIMEOUT_S=45
# Modelo usado nas delegações. Vazio = usa o modelo padrão configurado no OpenClaw.
OPENCLAW_DELEGATE_MODEL=

# Home Assistant integration
HOME_ASSISTANT_ENABLED=0
HOME_ASSISTANT_URL=http://127.0.0.1:8123
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_TIMEOUT_S=15
HOME_ASSISTANT_SENSITIVE_DOMAINS=alarm_control_panel,lock,cover,security_system,button

# Speaker identity and memory
# Face-based speaker identification requires insightface and onnxruntime.
SPEAKER_ID_ENABLED=1
SPEAKER_ID_PROFILES_DIR=~/.dobby/face_profiles
# Voice-based speaker ID (requires sherpa-onnx). Voice profiles are learned automatically
# from face matches and stored next to the face profiles.
# Empty model path downloads the CAM++ model to models/speaker/ on first run.
VOICE_ID_ENABLED=1
VOICE_ID_MODEL_PATH=
# Presence: a person detector (YOLOX, COCO classes) lets the head follow people too far away
# for the face tracker, chooses whom to look at, and tells the model briefly who (or which cat/dog)
# arrived or left so it can greet them. Empty model downloads yolox_tiny to models/vision/ on first
# run; yolox_s reaches farther but is ~2x slower; efficientdet_lite0/2 (MediaPipe) are lighter but miss
# people with the wide-angle camera.
PRESENCE_ENABLED=1
PERSON_DETECTOR_MODEL=
# Seconds before the same person is greeted again
PRESENCE_GREET_COOLDOWN_S=10800
# Petting/taps on the head, detected from the mic array level (rules in src/prompts/touch.md).
# Petting = 100 ms windows above TOUCH_PET_DBFS; taps = a steady series of 3+ knocks, each window
# above TOUCH_TAP_DBFS. Both must also stand 15 dB above the room noise.
TOUCH_ENABLED=1
TOUCH_PET_DBFS=-18
TOUCH_TAP_DBFS=-15
# Seconds between spoken reactions of the same kind (the first one always speaks)
TOUCH_SPEAK_COOLDOWN_S=300
# Mic array gain, kept with its AGC off (the AGC collapses when the head is touched and boosts
# room noise up to 64x in silence, so a TV or footsteps look like petting). 0 leaves the AGC on.
MIC_FIXED_GAIN=2.0
# Per-speaker persistent memory requires mem0ai and an OpenAI API key
# (or GEMINI_API_KEY with CONVERSATION_PROVIDER=gemini, e.g. SPEAKER_MEMORY_MODEL=gemini-3.5-flash-lite).
# Facts are extracted from each conversation and injected at the next session start.
SPEAKER_MEMORY_ENABLED=0
SPEAKER_MEMORY_MODEL=gpt-4o-mini
SPEAKER_MEMORY_DIR=~/.dobby/memories

# Notifications and scheduled jobs
# Async notification server port.
NOTIFICATION_SERVER_PORT=18800
# Persistent storage for scheduled reminders across bridge restarts.
SCHEDULER_JOBS_FILE=~/.dobby/scheduler_jobs.json

# Weather tool
# Uses Open-Meteo and does not require an API key.
# WEATHER_DEFAULT_CITY=Rio de Janeiro

# Optional LLM overrides
# Defaults to OPENAI_API_KEY when LLM_API_KEY_ENV is not set.
# LLM_API_KEY_ENV=OPENAI_API_KEY
# LLM_API_BASE=https://api.openai.com/v1

# Credentials
OPENAI_API_KEY=

# Conversation provider: openai (default) or gemini
CONVERSATION_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_THINKING_LEVEL=low
GEMINI_VOICE=
GEMINI_VOICE_STYLE=
# Let Gemini stay silent when speech isn't addressed to Dobby (side conversations, TV)
GEMINI_PROACTIVE_AUDIO=1
