# Example environment file for Dobby bridge.
# Keep credentials empty here and set real values in your local .env file.

# Core bridge settings
BRIDGE_MODE=realtime
BRIDGE_LOG_LEVEL=INFO
REACHY_BRIDGE_URL=sdk
IDLE_SLEEP_TIMEOUT_S=300

# Realtime speech and audio
REALTIME_MODEL=gpt-realtime
REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
REALTIME_VAD_SILENCE_MS=200
REALTIME_VAD_PREFIX_PADDING_MS=150
STT_LANGUAGE=pt
# Native Reachy speaker volume (0-100).
# Use 100 on Raspberry Pi to force max output on bridge startup.
# Use -1 to keep the current system volume unchanged.
REACHY_OUTPUT_VOLUME=-1
# On Linux, use direct ALSA capture/playback for bridge audio instead of SDK GStreamer audio.
REACHY_DIRECT_ALSA_AUDIO=1

# Vision and motion tracking
VISION_DEBUG_WINDOW=0
VISION_DEBUG_LOG_INTERVAL_S=1.0
# Maximum width used for CPU-bound head and finger tracking.
# Lower values reduce Raspberry Pi load.
VISION_TRACKING_MAX_WIDTH=640
# Maximum tracking rate for CPU-bound head and finger tracking.
# Lower values reduce Raspberry Pi load.
VISION_TRACKING_FPS=15.0
HEAD_TRACKING_ENABLED=1
ANTENNA_FINGER_TRACKING_ENABLED=1
ANTENNA_FINGER_MAX_ANGLE_DEG=180.0
CAMERA_TOOL_ENABLED=1

# Offline wake word
OFFLINE_WAKEWORD_ENABLED=1
OFFLINE_WAKEWORD_ALIASES=reachy,dobby
OFFLINE_WAKEWORD_THRESHOLD=0.5
OFFLINE_WAKEWORD_FALLBACK_ON_SPEECH=1
OFFLINE_WAKEWORD_AUTO_CALIBRATION_ENABLED=1
OFFLINE_WAKEWORD_CALIBRATION_SECONDS=6.0
OFFLINE_WAKEWORD_CALIBRATION_MULTIPLIER=2.8
OFFLINE_WAKEWORD_FALLBACK_SPEECH_RMS_THRESHOLD=0.03
# Path to a custom openWakeWord .onnx model, for example models/wakeword/dobby.onnx.
# Leave empty to use the built-in openWakeWord models.
WAKEWORD_MODEL_PATH=

# Raspberry Pi and TUI integration
# SSH connection used by the TUI stats panel. Host may be a hostname or IP.
PI_SSH_HOST=raspberrypi.local
PI_SSH_USER=dobby

# OpenClaw delegation
OPENCLAW_ENABLED=1
OPENCLAW_WS_URL=ws://127.0.0.1:18789
OPENCLAW_BEARER_TOKEN=
OPENCLAW_TIMEOUT_S=45
OPENCLAW_DELEGATE_MODEL=anthropic/claude-sonnet-4-6

# Home Assistant integration
HOME_ASSISTANT_ENABLED=0
HOME_ASSISTANT_URL=http://127.0.0.1:8123
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_TIMEOUT_S=15
HOME_ASSISTANT_SENSITIVE_DOMAINS=alarm_control_panel,lock,cover,security_system,button

# Speaker identity and memory
# Face-based speaker identification requires insightface and onnxruntime.
SPEAKER_ID_ENABLED=1
SPEAKER_ID_PROFILES_DIR=~/.dobby/face_profiles
# Per-speaker persistent memory requires mem0ai and an OpenAI API key.
# Facts are extracted from each conversation and injected at the next session start.
SPEAKER_MEMORY_ENABLED=0
SPEAKER_MEMORY_MODEL=gpt-4o-mini
SPEAKER_MEMORY_DIR=~/.dobby/memories

# Notifications and scheduled jobs
# Async notification server port.
NOTIFICATION_SERVER_PORT=18800
# Persistent storage for scheduled reminders across bridge restarts.
SCHEDULER_JOBS_FILE=~/.dobby/scheduler_jobs.json

# Weather tool
# Uses Open-Meteo and does not require an API key.
# WEATHER_DEFAULT_CITY=Rio de Janeiro

# Optional LLM overrides
# Defaults to OPENAI_API_KEY when LLM_API_KEY_ENV is not set.
# LLM_API_KEY_ENV=OPENAI_API_KEY
# LLM_API_BASE=https://api.openai.com/v1

# Credentials
OPENAI_API_KEY=
